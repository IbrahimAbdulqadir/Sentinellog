# Copy this file to .env and fill in real values before running `python app.py`.
# install_sentinellog.sh generates SECRET_KEY/ENCRYPTION_KEY and prompts for the
# rest automatically on a Linux install — this file is for manual/dev setups.

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dashboard login, created on first run if no admin user exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Encrypts stored Telegram/email credentials at rest (models.EncryptedString).
# Required — the app cannot start without it. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional — powers the plain-language AI alert triage (core/ai_triage.py).
# Leave blank to skip AI triage; alerts still fire normally without it.
OPENAI_API_KEY=

# Optional — comma-separated IPs that active response will never block
# (core/active_response.py), e.g. your own office/admin IP.
WHITELIST_IPS=
